{
  "branches": [
    "main"
  ],
  "tagFormat": "v${version}",
  "plugins": [
    [
      "@semantic-release/commit-analyzer",
      {
        "preset": "conventionalcommits",
        "releaseRules": [
          {
            "type": "perf",
            "release": "patch"
          },
          {
            "type": "refactor",
            "release": false
          },
          {
            "type": "docs",
            "release": false
          },
          {
            "type": "chore",
            "release": false
          },
          {
            "scope": "themes",
            "release": "patch"
          }
        ]
      }
    ],
    [
      "@semantic-release/release-notes-generator",
      {
        "preset": "conventionalcommits",
        "presetConfig": {
          "types": [
            {
              "type": "feat",
              "section": "✨ 기능"
            },
            {
              "type": "fix",
              "section": "🐛 수정"
            },
            {
              "type": "perf",
              "section": "⚡ 성능"
            },
            {
              "type": "refactor",
              "section": "♻️ 리팩터링",
              "hidden": false
            },
            {
              "type": "docs",
              "section": "📝 문서",
              "hidden": false
            },
            {
              "type": "chore",
              "hidden": true
            },
            {
              "type": "ci",
              "hidden": true
            },
            {
              "type": "style",
              "hidden": true
            },
            {
              "type": "test",
              "hidden": true
            },
            {
              "type": "build",
              "hidden": true
            }
          ]
        }
      }
    ],
    [
      "@semantic-release/changelog",
      {
        "changelogFile": "CHANGELOG.md",
        "changelogTitle": "# Changelog\n\n모든 변경은 [Conventional Commits](https://www.conventionalcommits.org/ko/) 기반으로 semantic-release가 자동 생성합니다."
      }
    ],
    [
      "@semantic-release/exec",
      {
        "prepareCmd": "scripts/set-version.sh ${nextRelease.version} $GITHUB_RUN_NUMBER && python3 themes/build_zed_theme.py && python3 themes/build_preview.py && scripts/make-dmg.sh ${nextRelease.version} && scripts/update-cask.sh ${nextRelease.version} Casks"
      }
    ],
    [
      "@semantic-release/git",
      {
        "assets": [
          "CHANGELOG.md",
          "VERSION",
          "Config/Version.xcconfig",
          "themes/dist/hyperedit-themes.json",
          "docs/theme-preview.html",
          "Casks/hyperedit.rb"
        ],
        "message": "chore(release): ${nextRelease.version} [skip ci]\n\n${nextRelease.notes}"
      }
    ],
    [
      "@semantic-release/github",
      {
        "assets": [
          {
            "path": "dist/*.dmg",
            "label": "macOS 앱 (DMG)"
          },
          {
            "path": "dist/SHA256SUMS",
            "label": "SHA256SUMS"
          },
          {
            "path": "themes/dist/hyperedit-themes.json",
            "label": "Zed themes (hyperedit-themes.json)"
          }
        ],
        "successComment": false,
        "failComment": false,
        "failTitle": false,
        "releasedLabels": false,
        "releaseBodyTemplate": "<%= nextRelease.notes %>\n\n## Install (macOS 15+)\n\n- **Homebrew**: `brew tap Hyeongcheol-An/tap && brew install --cask hyperedit`\n- **DMG**: download **HyperEdit-<%= nextRelease.version %>.dmg** below, open it and drag `HyperEdit.app` to `Applications`. Builds are Developer ID signed and notarized, so they open without Gatekeeper warnings. Verify with `shasum -a 256 -c SHA256SUMS`.\n\n## 설치 (macOS 15+)\n\n- **Homebrew**: `brew tap Hyeongcheol-An/tap && brew install --cask hyperedit`\n- **DMG**: 아래 **HyperEdit-<%= nextRelease.version %>.dmg** 를 내려받아 열고 `HyperEdit.app` 을 `Applications` 로 드래그합니다. Developer ID 로 서명·공증된 빌드라 경고 없이 바로 열립니다.\n"
      }
    ]
  ]
}
