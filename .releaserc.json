{
  "branches": [
    "main"
  ],
  "tagFormat": "v${version}",
  "plugins": [
    [
      "@semantic-release/commit-analyzer",
      {
        "preset": "conventionalcommits",
        "releaseRules": [
          {
            "type": "perf",
            "release": "patch"
          },
          {
            "type": "refactor",
            "release": false
          },
          {
            "type": "docs",
            "release": false
          },
          {
            "type": "chore",
            "release": false
          },
          {
            "scope": "themes",
            "release": "patch"
          }
        ]
      }
    ],
    [
      "@semantic-release/release-notes-generator",
      {
        "preset": "conventionalcommits",
        "presetConfig": {
          "types": [
            {
              "type": "feat",
              "section": "✨ Features"
            },
            {
              "type": "fix",
              "section": "🐛 Bug Fixes"
            },
            {
              "type": "perf",
              "section": "⚡ Performance"
            },
            {
              "type": "refactor",
              "section": "♻️ Refactoring",
              "hidden": false
            },
            {
              "type": "docs",
              "section": "📝 Documentation",
              "hidden": false
            },
            {
              "type": "chore",
              "hidden": true
            },
            {
              "type": "ci",
              "hidden": true
            },
            {
              "type": "style",
              "hidden": true
            },
            {
              "type": "test",
              "hidden": true
            },
            {
              "type": "build",
              "hidden": true
            }
          ]
        }
      }
    ],
    [
      "@semantic-release/changelog",
      {
        "changelogFile": "CHANGELOG.md",
        "changelogTitle": "# Changelog\n\nGenerated by semantic-release from [Conventional Commits](https://www.conventionalcommits.org). Hand-written release notes live in `docs/release-notes/`."
      }
    ],
    [
      "@semantic-release/exec",
      {
        "prepareCmd": "scripts/set-version.sh ${nextRelease.version} $GITHUB_RUN_NUMBER && python3 themes/build_zed_theme.py && python3 themes/build_preview.py && scripts/make-dmg.sh ${nextRelease.version} && scripts/update-cask.sh ${nextRelease.version} Casks",
        "generateNotesCmd": "if [ -f docs/release-notes/v${nextRelease.version}.md ]; then cat docs/release-notes/v${nextRelease.version}.md; fi"
      }
    ],
    [
      "@semantic-release/git",
      {
        "assets": [
          "CHANGELOG.md",
          "VERSION",
          "Config/Version.xcconfig",
          "themes/dist/hyperedit-themes.json",
          "docs/theme-preview.html",
          "Casks/hyperedit.rb"
        ],
        "message": "chore(release): ${nextRelease.version} [skip ci]\n\n${nextRelease.notes}"
      }
    ],
    [
      "@semantic-release/github",
      {
        "assets": [
          {
            "path": "dist/*.dmg",
            "label": "HyperEdit for macOS (DMG, universal: Apple Silicon + Intel)"
          },
          {
            "path": "dist/SHA256SUMS",
            "label": "SHA256SUMS"
          },
          {
            "path": "themes/dist/hyperedit-themes.json",
            "label": "Zed themes (hyperedit-themes.json)"
          }
        ],
        "successComment": false,
        "failComment": false,
        "failTitle": false,
        "releasedLabels": false,
        "releaseBodyTemplate": "<%= nextRelease.notes %>\n\n## Downloads\n\n| Asset | Contents |\n|---|---|\n| **HyperEdit-<%= nextRelease.version %>-universal.dmg** | macOS app, **universal binary — Apple Silicon (arm64) and Intel (x86_64)**, macOS 15 or later, Developer ID signed and notarized |\n| SHA256SUMS | Checksum of the DMG — verify with `shasum -a 256 -c SHA256SUMS` |\n| hyperedit-themes.json | The 22 HyperEdit palettes as Zed themes |\n\n## Install\n\n- **Homebrew**: `brew tap Hyeongcheol-An/tap && brew install --cask hyperedit` (upgrade with `brew upgrade --cask hyperedit`)\n- **DMG**: open the DMG and drag `HyperEdit.app` to `Applications`. The app opens without Gatekeeper warnings.\n"
      }
    ]
  ]
}
