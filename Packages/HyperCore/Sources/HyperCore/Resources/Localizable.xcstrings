{
  "sourceLanguage": "en",
  "strings": {
    "'blockComment' must be [open, close]": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "'blockComment' 는 [여는 기호, 닫는 기호] 여야 합니다"
          }
        }
      }
    },
    "'extensions' or 'filenames' is required": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "'extensions' 또는 'filenames' 가 필요합니다"
          }
        }
      }
    },
    "'mode' must be one of code, markup, css, data, shell (got '%@')": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "'mode' 는 code, markup, css, data, shell 중 하나여야 합니다 ('%@')"
          }
        }
      }
    },
    "'multilineStrings' has too many entries (max 127)": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "'multilineStrings' 항목이 너무 많습니다 (최대 127)"
          }
        }
      }
    },
    "'name' is required": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "'name' 은 필수입니다"
          }
        }
      }
    },
    "'strings' entries must be a single character (got '%@')": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "'strings' 항목은 한 글자여야 합니다 ('%@')"
          }
        }
      }
    },
    "Blocked saving empty content (original had %lld characters). Undo (⌘Z) and save again.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم منع حفظ محتوى فارغ (كان الأصل يحتوي على %lld حرف). تراجع (⌘Z) ثم احفظ مرة أخرى."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sichern von leerem Inhalt blockiert (Original hatte %lld Zeichen). Widerrufen (⌘Z) und erneut sichern."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se bloqueó el guardado de contenido vacío (el original tenía %lld caracteres). Deshaz (⌘Z) y vuelve a guardar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistrement d'un contenu vide bloqué (l'original comptait %lld caractères). Annulez (⌘Z) puis enregistrez à nouveau."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "खाली सामग्री सहेजना रोका गया (मूल में %lld वर्ण थे)। पूर्ववत करें (⌘Z) और फिर से सहेजें।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "空の内容の保存をブロックしました (元の文書は %lld 文字)。取り消す (⌘Z) で戻してから保存し直してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "빈 내용 저장을 차단했습니다 (원본 %lld자). 되돌리기(⌘Z) 후 다시 저장하세요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Gravação de conteúdo vazio bloqueada (o original tinha %lld caracteres). Desfaça (⌘Z) e salve de novo."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã chặn lưu nội dung trống (bản gốc có %lld ký tự). Hoàn tác (⌘Z) rồi lưu lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已阻止存储空内容（原文有 %lld 个字符）。请撤销 (⌘Z) 后重新存储。"
          }
        }
      }
    },
    "External change detected — saving will overwrite it (the external copy is kept as a snapshot)": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم رصد تغيير خارجي — سيكتب الحفظ فوقه (تُحفظ النسخة الخارجية كلقطة)"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Externe Änderung erkannt – Sichern überschreibt sie (die externe Fassung bleibt als Schnappschuss erhalten)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambio externo detectado — al guardar se sobrescribirá (la copia externa se conserva como instantánea)"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Modification externe détectée — l'enregistrement l'écrasera (la copie externe est conservée comme instantané)"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बाहरी बदलाव मिला — सहेजने पर वह अधिलेखित हो जाएगा (बाहरी प्रति स्नैपशॉट के रूप में रखी गई है)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "外部での変更を検出 — 保存すると上書きされます (外部の版はスナップショットとして保管)"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "외부 변경 감지 — 저장 시 덮어씁니다 (외부본은 스냅샷 보관)"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Alteração externa detectada — salvar vai sobrescrevê-la (a cópia externa fica guardada como snapshot)"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Phát hiện thay đổi bên ngoài — lưu sẽ ghi đè lên (bản bên ngoài được giữ làm bản chụp)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "检测到外部更改 — 存储将覆盖它（外部版本已保留为快照）"
          }
        }
      }
    },
    "Loaded": {
