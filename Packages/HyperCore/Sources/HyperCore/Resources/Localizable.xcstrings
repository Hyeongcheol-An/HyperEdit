    "Open failed: cannot determine the text encoding (not UTF-8 / EUC-KR / Latin-1)": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "فشل الفتح: تعذر تحديد ترميز النص (ليس UTF-8 / EUC-KR / Latin-1)"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffnen fehlgeschlagen: Zeichencodierung nicht erkennbar (weder UTF-8 noch EUC-KR noch Latin-1)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Error al abrir: no se puede determinar la codificación del texto (no es UTF-8 / EUC-KR / Latin-1)"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Échec de l'ouverture : impossible de déterminer l'encodage du texte (ni UTF-8 / EUC-KR / Latin-1)"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "खोलना विफल: टेक्स्ट एन्कोडिंग निर्धारित नहीं हो सकी (UTF-8 / EUC-KR / Latin-1 नहीं)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "開けませんでした: テキストエンコーディングを判別できません (UTF-8 / EUC-KR / Latin-1 のいずれでもない)"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "열기 실패: 텍스트 인코딩을 판별할 수 없습니다 (UTF-8 / EUC-KR / Latin-1 아님)"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Falha ao abrir: não foi possível determinar a codificação do texto (não é UTF-8 / EUC-KR / Latin-1)"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mở thất bại: không xác định được bảng mã văn bản (không phải UTF-8 / EUC-KR / Latin-1)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开失败：无法确定文本编码（不是 UTF-8 / EUC-KR / Latin-1）"
          }
        }
      }
    },
