    "Saved · %@ · converted to UTF-8 because the original encoding cannot represent some characters": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم الحفظ · %@ · تم التحويل إلى UTF-8 لأن الترميز الأصلي لا يمكنه تمثيل بعض الأحرف"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gesichert · %@ · in UTF-8 umgewandelt, weil die ursprüngliche Codierung einige Zeichen nicht darstellen kann"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guardado · %@ · convertido a UTF-8 porque la codificación original no puede representar algunos caracteres"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistré · %@ · converti en UTF-8 car l'encodage d'origine ne peut pas représenter certains caractères"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सहेजा गया · %@ · UTF-8 में बदला गया क्योंकि मूल एन्कोडिंग कुछ वर्णों को नहीं दर्शा सकती"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存しました · %@ · 元のエンコーディングで表せない文字があるため UTF-8 に変換"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장됨 · %@ · 원 인코딩에 없는 문자가 있어 UTF-8 로 변환 저장"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Salvo · %@ · convertido para UTF-8 porque a codificação original não representa alguns caracteres"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã lưu · %@ · đã chuyển sang UTF-8 vì bảng mã gốc không biểu diễn được một số ký tự"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已存储 · %@ · 原编码无法表示部分字符，已转换为 UTF-8"
          }
        }
      }
    },
