{
  "sourceLanguage": "en",
  "strings": {
    "'blockComment' must be [open, close]": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يجب أن يكون 'blockComment' بالشكل [فتح، إغلاق]"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "'blockComment' muss [öffnend, schließend] sein"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "'blockComment' debe ser [apertura, cierre]"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "'blockComment' doit être [ouverture, fermeture]"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "'blockComment' [खोलने का, बंद करने का] होना चाहिए"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "'blockComment' は [開始, 終了] である必要があります"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "'blockComment' 는 [여는 기호, 닫는 기호] 여야 합니다"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "'blockComment' deve ser [abertura, fechamento]"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "'blockComment' phải là [mở, đóng]"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "'blockComment' 必须为 [起始符, 结束符]"
          }
        }
      }
    },
    "'extensions' or 'filenames' is required": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يلزم 'extensions' أو 'filenames'"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "'extensions' oder 'filenames' ist erforderlich"
          }
        },
        "es": {
