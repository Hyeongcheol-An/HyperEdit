          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "'mode' phải là một trong code, markup, css, data, shell (nhận được '%@')"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "'mode' 必须是 code, markup, css, data, shell 之一（实际为 '%@'）"
