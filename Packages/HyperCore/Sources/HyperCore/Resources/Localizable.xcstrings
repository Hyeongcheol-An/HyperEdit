            "state": "translated",
            "value": "Se requiere 'extensions' o 'filenames'"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "'extensions' ou 'filenames' est obligatoire"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "'extensions' या 'filenames' आवश्यक है"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "'extensions' または 'filenames' が必要です"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "'extensions' 또는 'filenames' 가 필요합니다"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "'extensions' ou 'filenames' é obrigatório"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cần có 'extensions' hoặc 'filenames'"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "必须提供 'extensions' 或 'filenames'"
          }
        }
      }
    },
    "'mode' must be one of code, markup, css, data, shell (got '%@')": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يجب أن يكون 'mode' أحد code, markup, css, data, shell (القيمة '%@')"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "'mode' muss code, markup, css, data oder shell sein (erhalten: '%@')"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "'mode' debe ser code, markup, css, data o shell (se recibió '%@')"
          }
        },
        "fr": {
