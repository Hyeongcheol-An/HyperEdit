    "Name the last recorded macro — it appears in the Macro menu": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تسمية آخر ماكرو مسجَّل — يظهر في قائمة الماكرو"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dem zuletzt aufgezeichneten Makro einen Namen geben – es erscheint im Menü „Makro“"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dar nombre a la última macro grabada — aparece en el menú Macro"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nomme la dernière macro enregistrée — elle apparaît dans le menu Macro"
