    "Syntax colors by file type — URLs, dates, headings and tags in notes; keywords, strings and comments in code (⌃⌘H)": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ألوان الصياغة حسب نوع الملف — عناوين URL والتواريخ والعناوين والوسوم في الملاحظات؛ الكلمات المفتاحية والسلاسل النصية والتعليقات في التعليمات البرمجية (⌃⌘H)"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Syntaxfarben je Dateityp – URLs, Datumsangaben, Überschriften und Tags in Notizen; Schlüsselwörter, Strings und Kommentare in Code (⌃⌘H)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Colores de sintaxis según el tipo de archivo — URL, fechas, encabezados y etiquetas en notas; palabras clave, cadenas y comentarios en código (⌃⌘H)"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Coloration syntaxique selon le type de fichier — URL, dates, titres et tags dans les notes ; mots-clés, chaînes et commentaires dans le code (⌃⌘H)"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "फ़ाइल प्रकार के अनुसार सिंटैक्स रंग — नोट्स में URL, दिनांक, शीर्षक और टैग; कोड में कीवर्ड, स्ट्रिंग और कमेंट (⌃⌘H)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファイル種別ごとの構文の色分け — メモでは URL・日付・見出し・タグ、コードではキーワード・文字列・コメント (⌃⌘H)"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파일 종류별 구문 색 — 메모에서는 URL·날짜·헤딩·태그, 코드에서는 키워드·문자열·주석 (⌃⌘H)"
          }
