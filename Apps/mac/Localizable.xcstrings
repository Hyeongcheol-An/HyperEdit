          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カーソル位置の領域を折りたたみます — インデントブロック、Markdown 見出し、{ } ブロック (⌥⌘←)"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "캐럿이 있는 영역 접기 — 들여쓴 블록, 마크다운 헤딩, { } 블록 (⌥⌘←)"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Recolhe a região no cursor — bloco indentado, título Markdown ou bloco { } (⌥⌘←)"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thu gọn vùng tại con trỏ — khối thụt lề, tiêu đề Markdown hoặc khối { } (⌥⌘←)"
