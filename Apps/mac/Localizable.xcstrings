    "Pretty-print the selection or the whole document as JSON — key order and numbers are kept (⌃⌘J)": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تنسيق التحديد أو المستند كله كـ JSON مقروء — يُحتفظ بترتيب المفاتيح وصيغة الأرقام (⌃⌘J)"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auswahl oder das ganze Dokument als JSON formatieren – Reihenfolge der Schlüssel und Zahlen bleiben erhalten (⌃⌘J)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Formatear la selección o todo el documento como JSON legible — se conservan el orden de las claves y los números (⌃⌘J)"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Met en forme la sélection ou tout le document en JSON lisible — l'ordre des clés et les nombres sont conservés (⌃⌘J)"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "चयन या पूरे दस्तावेज़ को सुव्यवस्थित JSON में बदलें — कुंजी क्रम और संख्याएँ ज्यों की त्यों रहती हैं (⌃⌘J)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択範囲 (なければ書類全体) を読みやすい JSON に整形します — キーの順序と数値の表記はそのまま (⌃⌘J)"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택 영역(없으면 문서 전체)을 보기 좋은 JSON 으로 — 키 순서와 숫자 표기는 그대로 (⌃⌘J)"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Formata a seleção (ou o documento inteiro) como JSON legível — a ordem das chaves e os números são mantidos (⌃⌘J)"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Định dạng đẹp vùng chọn hoặc toàn bộ tài liệu thành JSON — giữ nguyên thứ tự khóa và số (⌃⌘J)"
          }
        },
        "zh-Hans": {
