        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "마지막으로 기록한 매크로에 이름을 붙임 — 매크로 메뉴에 나타남"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Dá um nome à última macro gravada — ela aparece no menu Macro"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đặt tên cho macro vừa ghi — nó sẽ xuất hiện trong menu Macro"
