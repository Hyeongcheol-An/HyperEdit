    "No bookmarks. Press ⌘F2 in the editor to bookmark the current line, then F2 / ⌥F2 to jump to the next / previous bookmark.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا توجد إشارات مرجعية. اضغط ⌘F2 في المحرر لإضافة إشارة مرجعية إلى السطر الحالي، ثم F2 / ⌥F2 للانتقال إلى الإشارة التالية / السابقة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Lesezeichen. Drücke im Editor ⌘F2, um die aktuelle Zeile mit einem Lesezeichen zu versehen, und F2 / ⌥F2, um zum nächsten / vorherigen Lesezeichen zu springen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay marcadores. Pulsa ⌘F2 en el editor para marcar la línea actual y luego F2 / ⌥F2 para ir al marcador siguiente / anterior."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun signet. Appuyez sur ⌘F2 dans l'éditeur pour marquer la ligne actuelle, puis sur F2 / ⌥F2 pour aller au signet suivant / précédent."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कोई बुकमार्क नहीं। वर्तमान पंक्ति बुकमार्क करने के लिए एडिटर में ⌘F2 दबाएँ, फिर अगले / पिछले बुकमार्क पर जाने के लिए F2 / ⌥F2 दबाएँ।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ブックマークはありません。エディタで ⌘F2 を押すと現在の行をブックマークでき、F2 / ⌥F2 で次 / 前のブックマークへ移動します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "북마크가 없습니다. 편집기에서 ⌘F2 로 현재 줄을 북마크하고, F2 / ⌥F2 로 다음·이전 북마크로 이동하세요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhum marcador. Pressione ⌘F2 no editor para marcar a linha atual e depois F2 / ⌥F2 para ir ao marcador seguinte / anterior."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chưa có dấu trang. Nhấn ⌘F2 trong trình soạn thảo để đánh dấu dòng hiện tại, rồi F2 / ⌥F2 để nhảy tới dấu trang kế tiếp / trước."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂无书签。在编辑器中按 ⌘F2 为当前行添加书签，再按 F2 / ⌥F2 跳到下一个 / 上一个书签。"
          }
        }
      }
    },
    "No emergency copy could be written. Quit anyway, or cancel to keep editing?": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذر حفظ نسخة طارئة. هل تريد الإنهاء على أي حال، أم الإلغاء لمتابعة التحرير؟"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es konnte keine Notfallkopie geschrieben werden. Trotzdem beenden oder abbrechen und weiter bearbeiten?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo escribir ninguna copia de emergencia. ¿Salir de todos modos o cancelar para seguir editando?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune copie de secours n'a pu être écrite. Quitter quand même, ou annuler pour continuer à modifier ?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपातकालीन प्रति भी नहीं लिखी जा सकी। फिर भी छोड़ें, या संपादन जारी रखने के लिए रद्द करें?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "緊急コピーも書き出せませんでした。このまま終了しますか？ キャンセルすると編集を続けられます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "비상 사본도 쓰지 못했습니다. 그래도 종료할까요, 아니면 취소하고 계속 편집할까요?"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível gravar uma cópia de emergência. Encerrar mesmo assim ou cancelar para continuar editando?"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể ghi bản sao khẩn cấp. Vẫn thoát, hay hủy để tiếp tục chỉnh sửa?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法写入紧急副本。仍要退出，还是取消并继续编辑？"
          }
        }
      }
    },
    "No macro recorded yet (⇧⌘M to record)": {
      "localizations": {
        "ar": {
