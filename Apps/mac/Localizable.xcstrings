    "Inserts a sequence number on each line of the column selection (or at each caret). Numbers are zero-padded to the same width.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُدرج رقمًا متسلسلًا في كل سطر من التحديد العمودي (أو عند كل مؤشر). تُكمَل الأرقام بالأصفار لتتساوى في العرض."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fügt in jeder Zeile der Spaltenauswahl (oder an jedem Cursor) eine fortlaufende Nummer ein. Die Zahlen werden mit Nullen auf gleiche Breite aufgefüllt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inserta un número secuencial en cada línea de la selección de columna (o en cada cursor). Los números se rellenan con ceros hasta el mismo ancho."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Insère un numéro de séquence sur chaque ligne de la sélection en colonne (ou à chaque curseur). Les numéros sont complétés par des zéros pour avoir la même largeur."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कॉलम चयन की हर पंक्ति (या हर कर्सर) पर एक क्रम संख्या डालता है। संख्याओं को समान चौड़ाई तक शून्य से भरा जाता है।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "列選択の各行 (または各カーソル位置) に連番を挿入します。桁数は 0 で揃えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "열 선택(또는 멀티 커서)의 각 줄에 순번을 넣습니다. 자릿수는 0으로 맞춥니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Insere um número sequencial em cada linha da seleção em coluna (ou em cada cursor). Os números são preenchidos com zeros até ficarem com a mesma largura."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chèn số thứ tự trên mỗi dòng của vùng chọn cột (hoặc tại mỗi con trỏ). Các số được đệm số 0 cho cùng độ rộng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在列选区的每一行（或每个光标处）插入序号。数字会补零至相同宽度。"
          }
        }
      }
    },
