    "An emergency copy of the unsaved text was written to %@. Quit anyway, or cancel to keep editing?": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم حفظ نسخة طارئة من النص غير المحفوظ في %@. هل تريد الإنهاء على أي حال، أم الإلغاء لمتابعة التحرير؟"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Notfallkopie des ungesicherten Texts wurde unter %@ abgelegt. Trotzdem beenden oder abbrechen und weiter bearbeiten?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se escribió una copia de emergencia del texto sin guardar en %@. ¿Salir de todos modos o cancelar para seguir editando?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une copie de secours du texte non enregistré a été écrite dans %@. Quitter quand même, ou annuler pour continuer à modifier ?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सहेजे न गए टेक्स्ट की एक आपातकालीन प्रति %@ पर लिखी गई। फिर भी छोड़ें, या संपादन जारी रखने के लिए रद्द करें?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "未保存のテキストの緊急コピーを %@ に書き出しました。このまま終了しますか？ キャンセルすると編集を続けられます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장되지 않은 내용의 비상 사본을 %@ 에 남겼습니다. 그래도 종료할까요, 아니면 취소하고 계속 편집할까요?"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma cópia de emergência do texto não salvo foi gravada em %@. Encerrar mesmo assim ou cancelar para continuar editando?"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bản sao khẩn cấp của văn bản chưa lưu đã được ghi vào %@. Vẫn thoát, hay hủy để tiếp tục chỉnh sửa?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未存储文本的紧急副本已写入 %@。仍要退出，还是取消并继续编辑？"
          }
        }
      }
    },
    "Applied after HyperEdit relaunches — the document is saved first.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُطبَّق بعد إعادة تشغيل HyperEdit — يُحفظ المستند أولًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wird nach dem Neustart von HyperEdit übernommen – das Dokument wird vorher gesichert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se aplica cuando HyperEdit se reinicia — el documento se guarda primero."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appliqué au redémarrage de HyperEdit — le document est d'abord enregistré."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "HyperEdit के रीलॉन्च होने पर लागू होगा — पहले दस्तावेज़ सहेजा जाता है।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "HyperEdit の再起動後に適用されます — 書類は先に保存されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "HyperEdit 를 재실행하면 적용됩니다 — 문서는 먼저 저장됩니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplicado depois que o HyperEdit reinicia — o documento é salvo antes."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Áp dụng sau khi HyperEdit khởi chạy lại — tài liệu được lưu trước."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "HyperEdit 重新启动后生效 — 会先存储文稿。"
          }
        }
      }
    },
