    "⌘D — add the next occurrence of the selection as a caret": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘D — إضافة التكرار التالي للتحديد كمؤشر"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘D – nächstes Vorkommen der Auswahl als Cursor hinzufügen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘D — añadir la siguiente aparición de la selección como cursor"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘D — ajoute l'occurrence suivante de la sélection comme curseur"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘D — चयन की अगली उपस्थिति को कर्सर के रूप में जोड़ें"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘D — 選択テキストの次の出現箇所をカーソルとして追加"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘D — 선택과 같은 글자의 다음 등장을 커서에 추가"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘D — adiciona a próxima ocorrência da seleção como um cursor"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘D — thêm lần xuất hiện kế tiếp của vùng chọn làm một con trỏ"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘D — 将所选文本的下一处出现添加为光标"
          }
        }
      }
    },
    "⌘F — results are listed in the 'Find Results' panel below": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘F — تُدرج النتائج في لوحة «نتائج البحث» بالأسفل"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘F – die Treffer werden unten im Panel „Suchergebnisse“ aufgelistet"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘F — los resultados se listan en el panel 'Resultados de búsqueda' de abajo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘F — les résultats sont listés dans le volet « Résultats de recherche » en bas"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘F — परिणाम नीचे 'खोज परिणाम' पैनल में सूचीबद्ध होते हैं"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘F — 結果は下の「検索結果」パネルに一覧表示されます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘F — 하단 '찾기 결과' 창에 결과 목록"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘F — os resultados aparecem no painel 'Resultados da Busca' abaixo"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘F — kết quả được liệt kê trong bảng 'Kết quả tìm kiếm' bên dưới"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘F — 结果会列在下方的“查找结果”面板中"
          }
        }
      }
    },
    "⌘F2 — toggle a bookmark on the current line": {
