    "Save failed on quit — emergency copy written to %@": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "فشل الحفظ عند الإنهاء — تم حفظ نسخة طارئة في %@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sichern beim Beenden fehlgeschlagen – Notfallkopie unter %@ abgelegt"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Error al guardar al salir — copia de emergencia escrita en %@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Échec de l'enregistrement à la fermeture — copie de secours écrite dans %@"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "छोड़ते समय सहेजना विफल — आपातकालीन प्रति %@ पर लिखी गई"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "終了時の保存に失敗 — 緊急コピーを %@ に書き出しました"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "종료 시 저장 실패 — 비상 사본을 %@ 에 남겼습니다"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Falha ao salvar ao encerrar — cópia de emergência gravada em %@"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lưu thất bại khi thoát — đã ghi bản sao khẩn cấp vào %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "退出时存储失败 — 紧急副本已写入 %@"
          }
        }
      }
    },
    "Save failed on quit — no emergency copy could be written": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "فشل الحفظ عند الإنهاء — تعذر حفظ نسخة طارئة"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sichern beim Beenden fehlgeschlagen – es konnte keine Notfallkopie geschrieben werden"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Error al guardar al salir — no se pudo escribir ninguna copia de emergencia"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Échec de l'enregistrement à la fermeture — aucune copie de secours n'a pu être écrite"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "छोड़ते समय सहेजना विफल — कोई आपातकालीन प्रति नहीं लिखी जा सकी"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "終了時の保存に失敗 — 緊急コピーも書き出せませんでした"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "종료 시 저장 실패 — 비상 사본도 쓰지 못했습니다"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Falha ao salvar ao encerrar — não foi possível gravar uma cópia de emergência"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lưu thất bại khi thoát — không thể ghi bản sao khẩn cấp"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "退出时存储失败 — 无法写入紧急副本"
          }
        }
      }
    },
    "Save now (⌘S) — autosaves 2 seconds after you stop typing": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الحفظ الآن (⌘S) — يُحفظ تلقائيًا بعد ثانيتين من التوقف عن الكتابة"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jetzt sichern (⌘S) – automatisch gesichert wird 2 Sekunden nach der letzten Eingabe"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guardar ahora (⌘S) — se guarda automáticamente 2 segundos después de dejar de escribir"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistre maintenant (⌘S) — enregistrement automatique 2 secondes après la fin de la saisie"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अभी सहेजें (⌘S) — टाइप करना बंद करने के 2 सेकंड बाद अपने आप सहेजता है"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今すぐ保存 (⌘S) — 入力を止めると 2 秒後に自動保存します"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지금 저장 (⌘S) — 입력을 멈추면 2초 뒤 자동 저장"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Salva agora (⌘S) — salva automaticamente 2 segundos depois que você para de digitar"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lưu ngay (⌘S) — tự động lưu 2 giây sau khi bạn ngừng gõ"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "立即存储 (⌘S) — 停止输入 2 秒后会自动存储"
          }
        }
      }
    },
    "Saved macros are listed in the Macro menu and kept in ~/Library/Application Support/HyperEdit/macros/macros.json.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُدرج وحدات الماكرو المحفوظة في قائمة الماكرو وتُحفظ في ~/Library/Application Support/HyperEdit/macros/macros.json."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gesicherte Makros stehen im Menü „Makro“ und liegen in ~/Library/Application Support/HyperEdit/macros/macros.json."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las macros guardadas aparecen en el menú Macro y se conservan en ~/Library/Application Support/HyperEdit/macros/macros.json."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les macros sauvegardées figurent dans le menu Macro et sont conservées dans ~/Library/Application Support/HyperEdit/macros/macros.json."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सहेजे गए मैक्रो 'मैक्रो' मेनू में सूचीबद्ध होते हैं और ~/Library/Application Support/HyperEdit/macros/macros.json में रखे जाते हैं।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存したマクロはマクロメニューに表示され、~/Library/Application Support/HyperEdit/macros/macros.json に保管されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장한 매크로는 매크로 메뉴에 나열되며 ~/Library/Application Support/HyperEdit/macros/macros.json 에 보관됩니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As macros salvas aparecem no menu Macro e ficam em ~/Library/Application Support/HyperEdit/macros/macros.json."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các macro đã lưu được liệt kê trong menu Macro và lưu tại ~/Library/Application Support/HyperEdit/macros/macros.json."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已存储的宏会列在“宏”菜单中，并保存在 ~/Library/Application Support/HyperEdit/macros/macros.json。"
          }
        }
      }
