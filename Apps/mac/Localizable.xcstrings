    "Theme — with Follow System Appearance on, Hyper Light/Dark follow the system light/dark setting": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "السمة — عند تشغيل اتباع مظهر النظام، تتبع Hyper Light/Dark إعداد النظام الفاتح/الداكن"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Theme – bei „Erscheinungsbild des Systems folgen“ richten sich Hyper Light/Dark nach der Hell/Dunkel-Einstellung des Systems"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tema — con Seguir la apariencia del sistema activado, Hyper Light/Dark siguen el ajuste claro/oscuro del sistema"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Thème — avec « Suivre l'apparence du système » activé, Hyper Light/Dark suivent le réglage clair/sombre du système"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "थीम — 'सिस्टम अपीयरेंस का अनुसरण करें' चालू होने पर Hyper Light/Dark सिस्टम की लाइट/डार्क सेटिंग का अनुसरण करते हैं"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "テーマ — 「システムの外観に合わせる」がオンのとき、Hyper Light/Dark がシステムのライト/ダーク設定に追従します"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "테마 — 시스템 외형 따르기를 켜면 라이트/다크에 맞춰 Hyper Light/Dark 로 자동 전환"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Tema — com Seguir Aparência do Sistema ativado, Hyper Light/Dark acompanham o modo claro/escuro do sistema"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chủ đề — khi bật Theo giao diện hệ thống, Hyper Light/Dark đổi theo chế độ sáng/tối của hệ thống"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "主题 — 开启“跟随系统外观”时，Hyper Light/Dark 会随系统的浅色/深色设置切换"
          }
        }
      }
    },
