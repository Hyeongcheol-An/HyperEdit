        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अंतिम रिकॉर्ड किए मैक्रो को नाम दें — यह मैक्रो मेनू में दिखेगा"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最後に記録したマクロに名前を付けます — マクロメニューに表示されます"
