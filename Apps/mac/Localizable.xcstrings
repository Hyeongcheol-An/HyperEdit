    "Join the selected lines into one (with no selection: current line + next line) (⇧⌘J)": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "دمج الأسطر المحددة في سطر واحد (دون تحديد: السطر الحالي + السطر التالي) (⇧⌘J)"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gewählte Zeilen zu einer verbinden (ohne Auswahl: aktuelle + nächste Zeile) (⇧⌘J)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Unir las líneas seleccionadas en una sola (sin selección: línea actual + línea siguiente) (⇧⌘J)"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Joint les lignes sélectionnées en une seule (sans sélection : ligne actuelle + ligne suivante) (⇧⌘J)"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "चुनी गई पंक्तियों को एक में जोड़ें (बिना चयन: वर्तमान पंक्ति + अगली पंक्ति) (⇧⌘J)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択した行を 1 行に結合します (選択がなければ現在の行 + 次の行) (⇧⌘J)"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택 줄을 한 줄로 (선택이 없으면 현재 줄 + 다음 줄) (⇧⌘J)"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Une as linhas selecionadas em uma só (sem seleção: linha atual + linha seguinte) (⇧⌘J)"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nối các dòng đã chọn thành một (không có vùng chọn: dòng hiện tại + dòng kế) (⇧⌘J)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将所选行合并为一行（未选择时：当前行 + 下一行）(⇧⌘J)"
          }
        }
      }
    },
