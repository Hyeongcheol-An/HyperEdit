    "⌥C — drag or ⇧arrows select a rectangle; typing applies to every line": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "⌥C — السحب أو ⇧الأسهم يحددان مستطيلًا؛ وتنطبق الكتابة على كل سطر"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "⌥C – Ziehen oder ⇧Pfeiltasten wählen ein Rechteck aus; Eingaben gelten für jede Zeile"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "⌥C — arrastrar o ⇧flechas seleccionan un rectángulo; lo que escribes se aplica a todas las líneas"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "⌥C — glisser ou ⇧flèches sélectionne un rectangle ; la saisie s'applique à chaque ligne"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "⌥C — ड्रैग या ⇧तीर कुंजियों से आयत चुनें; टाइपिंग हर पंक्ति पर लागू होती है"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "⌥C — ドラッグまたは ⇧矢印キーで矩形選択、入力はすべての行に適用されます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "⌥C — 드래그/⇧방향키로 사각형 선택, 입력은 모든 줄에"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "⌥C — arrastar ou ⇧setas selecionam um retângulo; digitar afeta todas as linhas"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "⌥C — kéo hoặc ⇧phím mũi tên để chọn hình chữ nhật; gõ áp dụng cho mọi dòng"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "⌥C — 拖动或 ⇧方向键选择矩形区域；输入会应用到每一行"
          }
        }
      }
    },
