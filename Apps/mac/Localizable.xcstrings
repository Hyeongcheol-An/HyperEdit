    "Headings (##), [Title] lines, 가./나. items and 1) items appear in the outline.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تظهر في المخطط التفصيلي العناوين (##) وأسطر [العنوان] وعناصر 가./나. وعناصر 1)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Überschriften (##), [Titel]-Zeilen, 가./나.-Punkte und 1)-Punkte erscheinen in der Gliederung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En el esquema aparecen los encabezados (##), las líneas [Título], los elementos 가./나. y los elementos 1)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les titres (##), les lignes [Titre], les éléments 가./나. et 1) apparaissent dans le plan."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "शीर्षक (##), [शीर्षक] पंक्तियाँ, 가./나. आइटम और 1) आइटम आउटलाइन में दिखते हैं।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "見出し (##)、[タイトル] 行、가./나. 項目、1) 項目がアウトラインに表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "헤딩(##), [제목], 가./나., 1) 항목이 아웃라인에 표시됩니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Títulos (##), linhas [Título], itens 가./나. e itens 1) aparecem na estrutura."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiêu đề (##), dòng [Tiêu đề], mục 가./나. và mục 1) sẽ xuất hiện trong dàn ý."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "标题 (##)、[标题] 行、가./나. 项和 1) 项会显示在大纲中。"
          }
        }
      }
    },
