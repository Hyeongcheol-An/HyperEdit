    "Play the last macro several times — stops when a Find step finds nothing or a run changes nothing": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تشغيل آخر ماكرو عدة مرات — يتوقف عندما لا تجد خطوة بحث شيئًا أو لا تغيّر دورة شيئًا"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das letzte Makro mehrmals abspielen – stoppt, wenn ein Suchschritt nichts findet oder ein Durchlauf nichts ändert"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reproducir la última macro varias veces — se detiene cuando un paso de búsqueda no encuentra nada o una pasada no cambia nada"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Exécute la dernière macro plusieurs fois — s'arrête quand une étape Rechercher ne trouve rien ou qu'un passage ne change rien"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अंतिम मैक्रो कई बार चलाएँ — जब कोई ढूँढने का चरण कुछ न पाए या किसी रन में कुछ न बदले, तो रुक जाता है"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最後のマクロを複数回再生します — 検索ステップが何も見つけないか、1 回の実行で何も変わらなければ停止します"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "마지막 매크로를 여러 번 재생 — 찾기 단계가 실패하거나 한 바퀴에 아무 변화가 없으면 멈춤"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Reproduz a última macro várias vezes — para quando uma etapa de busca não encontra nada ou uma execução não altera nada"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Phát macro gần nhất nhiều lần — dừng khi bước Tìm không thấy gì hoặc một lượt không thay đổi gì"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "多次播放最近的宏 — 当查找步骤无结果或某一轮未产生更改时停止"
          }
        }
      }
    },
