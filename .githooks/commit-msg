#!/usr/bin/env bash
# Conventional Commits 형식 검사: type(scope)!: subject
msg="$(head -n1 "$1")"
case "$msg" in
  Merge*|Revert*|fixup!*|squash!*) exit 0 ;;
esac
if ! printf '%s' "$msg" | grep -Eq '^(feat|fix|perf|refactor|docs|style|test|build|ci|chore|revert)(\([a-z0-9._/-]+\))?!?: .{1,100}$'; then
  echo "✗ 커밋 메시지가 Conventional Commits 형식이 아닙니다:" >&2
  echo "  $msg" >&2
  echo "  예) feat(editor): 컬럼 모드 선택 추가 / fix(sync): 충돌 병합 순서 수정 / docs: README 갱신" >&2
  exit 1
fi
