{
  "name": "hyperedit",
  "version": "0.0.0-semantic-release",
  "private": true,
  "description": "HyperEdit — ribbon-style plain-text editor for macOS. This package.json only hosts the release tooling (semantic-release, commitlint); the app itself is Swift.",
  "repository": { "type": "git", "url": "https://github.com/Hyeongcheol-An/HyperEdit.git" },
  "scripts": {
    "themes:build": "python3 themes/build_zed_theme.py",
    "themes:install": "python3 themes/build_zed_theme.py --install",
    "themes:preview": "python3 themes/build_preview.py",
    "release": "semantic-release"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.0",
    "@commitlint/config-conventional": "^19.8.0",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/exec": "^7.0.3",
    "@semantic-release/git": "^10.0.1",
    "conventional-changelog-conventionalcommits": "^8.0.0",
    "semantic-release": "^24.2.3"
  }
}
